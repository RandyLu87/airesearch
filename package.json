{
  "name": "airesearch",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @airesearch/web",
    "publish": "npm run publish --workspace @airesearch/web",
    "research:close": "python3 docs/research/tools/research_close.py",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm test && python3 scripts/research/validate_research_paths.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
