# macOS metadata
.DS_Store
**/.DS_Store

# Temporary work and generated review artifacts
tmp/
**/tmp/
_smoke.*
**/review/
**/review-*/
**/swift-module-cache/
.codex-log/

# Editor and generic temporary files
*.swp
*.swo
*.tmp
*~

# Node / Next build state (final research/site output remains tracked)
node_modules/
**/.next/
apps/web/out/
*.tsbuildinfo

# Secrets. Tokens belong in the shell environment, never in the repo —
# see docs/research/data-source-registry.md section 2. These entries are a
# backstop against a slip, not an alternative storage location.
.env
.env.*
!.env.example
.claude/settings.local.json

# Python virtualenvs used for ad-hoc data probes
.venv/
**/.venv/
