# macOS metadata
.DS_Store
**/.DS_Store

# Python 字节码：docs/research/tools 里的脚本被 import 时会生成
__pycache__/
*.pyc

# Temporary work and generated review artifacts
tmp/
**/tmp/
_smoke.*
**/review/
**/review-*/
**/swift-module-cache/
.codex-log/

# Editor and generic temporary files
*.swp
*.swo
*.tmp
*~

# Node / Next build state (final research/site output remains tracked)
node_modules/
**/.next/
apps/web/out/
*.tsbuildinfo

# Secrets. Tokens belong in the shell environment, never in the repo —
# see docs/model/financial-data.md「Tushare 使用规范 / token 规则」。These
# entries are a backstop against a slip, not an alternative storage location.
.env
.env.*
!.env.example
.claude/settings.local.json

# Python virtualenvs used for ad-hoc data probes
.venv/
**/.venv/

# FinMind token（docs/research/tools/twstock_data.py 按脚本位置读取，严禁提交）
docs/research/local/

# 相邻的独立工程，不属于本仓库：AGENTS.md 规定本仓库不直接引用它，
# 用到什么先迁移进 docs/ 独立维护（约 75M，误提交会污染仓库体积与历史）
ai-berkshire/
