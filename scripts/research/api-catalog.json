{
  "schema_version": 1,
  "sec": {
    "provider": "SEC EDGAR",
    "ticker_exchange_url": "https://www.sec.gov/files/company_tickers_exchange.json",
    "submissions_url_template": "https://data.sec.gov/submissions/CIK{cik}.json",
    "companyfacts_url_template": "https://data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json",
    "archive_url_template": "https://www.sec.gov/Archives/edgar/data/{cik}/{accession}/{document}",
    "default_forms": [
      "10-K",
      "10-Q",
      "8-K",
      "20-F",
      "40-F",
      "6-K",
      "DEF 14A"
    ],
    "request_interval_seconds": 0.12
  },
  "tushare": {
    "provider": "Tushare Pro",
    "endpoint": "https://api.tushare.pro",
    "request_interval_seconds": 0.12,
    "profiles": {
      "a": [
        {"api": "daily", "dated": true},
        {"api": "daily_basic", "dated": true},
        {"api": "income"},
        {"api": "balancesheet"},
        {"api": "cashflow"},
        {"api": "fina_indicator"},
        {"api": "fina_mainbz"},
        {"api": "dividend"}
      ],
      "hk": [
        {"api": "hk_daily_adj", "dated": true},
        {"api": "hk_income"},
        {"api": "hk_balancesheet"},
        {"api": "hk_cashflow"},
        {"api": "hk_fina_indicator"}
      ],
      "us": [
        {"api": "us_daily", "dated": true},
        {"api": "us_income"},
        {"api": "us_balancesheet"},
        {"api": "us_cashflow"},
        {"api": "us_fina_indicator"}
      ]
    }
  },
  "fmp": {
    "provider": "Financial Modeling Prep",
    "base_url": "https://financialmodelingprep.com/stable",
    "mcp_url_template": "https://financialmodelingprep.com/mcp?apikey={apikey}",
    "request_interval_seconds": 0.7,
    "row_limit": 5,
    "profiles": {
      "us": [
        {"label": "profile", "endpoint": "profile"},
        {"label": "quote", "endpoint": "quote"},
        {"label": "price-eod", "endpoint": "historical-price-eod/full", "dated": true},
        {"label": "income-annual", "endpoint": "income-statement", "params": {"period": "annual", "limit": 5}},
        {"label": "income-quarter", "endpoint": "income-statement", "params": {"period": "quarter", "limit": 5}},
        {"label": "balance-annual", "endpoint": "balance-sheet-statement", "params": {"period": "annual", "limit": 5}},
        {"label": "balance-quarter", "endpoint": "balance-sheet-statement", "params": {"period": "quarter", "limit": 5}},
        {"label": "cashflow-annual", "endpoint": "cash-flow-statement", "params": {"period": "annual", "limit": 5}},
        {"label": "cashflow-quarter", "endpoint": "cash-flow-statement", "params": {"period": "quarter", "limit": 5}},
        {"label": "segments-product-annual", "endpoint": "revenue-product-segmentation", "params": {"period": "annual"}},
        {"label": "segments-geographic-annual", "endpoint": "revenue-geographic-segmentation", "params": {"period": "annual"}},
        {"label": "key-metrics-annual", "endpoint": "key-metrics", "params": {"period": "annual", "limit": 5}},
        {"label": "ratios-annual", "endpoint": "ratios", "params": {"period": "annual", "limit": 5}},
        {"label": "enterprise-values", "endpoint": "enterprise-values", "params": {"limit": 5}},
        {"label": "employee-count", "endpoint": "employee-count", "params": {"limit": 5}},
        {"label": "analyst-estimates-annual", "endpoint": "analyst-estimates", "params": {"period": "annual", "limit": 5}},
        {"label": "earnings", "endpoint": "earnings", "params": {"limit": 5}}
      ]
    }
  }
}
